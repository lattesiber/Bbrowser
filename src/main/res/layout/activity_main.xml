<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- TOP BAR: URL / Search + Settings -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:elevation="6dp"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/urlContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#334155"
            android:paddingHorizontal="10dp">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search or enter URL..."
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#38BDF8" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <!-- CONTENT AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomBar">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/fullScreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <!-- HOME WELCOME -->
        <ScrollView
            android:id="@+id/homeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtHomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bbrowser"
                    android:textColor="#38BDF8"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHomeSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast, Secure, and Customizable Web"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS PANEL -->
        <ScrollView
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E293B"
            android:padding="16dp"
            android:elevation="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#38BDF8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- THEME SELECTION -->
                <TextView
                    android:id="@+id/lblTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme Selection:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbDarkTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark Mode (Dark Blue)"
                        android:textColor="#FFFFFF"
                        android:checked="true"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbLightTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light Mode (Light Blue)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </RadioGroup>

                <!-- SEARCH ENGINE -->
                <TextView
                    android:id="@+id/lblSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Engine:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/rgSearchEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbDuck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DuckDuckGo"
                        android:textColor="#FFFFFF"
                        android:checked="true"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbGoogle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rbBing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bing"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </RadioGroup>

                <!-- LANGUAGE SELECTION -->
                <TextView
                    android:id="@+id/lblLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Language:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#334155"
                    android:layout_marginTop="6dp" />

                <!-- HISTORY AND COOKIES BUTTONS -->
                <TextView
                    android:id="@+id/lblData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data &amp; Privacy:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btnShowHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View History"
                    android:backgroundTint="#334155"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnClearCookies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Cookies &amp; Cache"
                    android:backgroundTint="#EF4444"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp" />

                <!-- ABOUT SECTION -->
                <TextView
                    android:id="@+id/lblAboutHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0F172A"
                    android:padding="12dp"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bbrowser"
                        android:textColor="#38BDF8"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version: 1.0"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/txtWebViewVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android WebView Version: Detecting..."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save and Close"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- HISTORY PANEL -->
        <LinearLayout
            android:id="@+id/panelHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="16dp"
            android:elevation="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browsing History"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginVertical="12dp">

                <TextView
                    android:id="@+id/txtHistoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClearHistoryList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear History"
                    android:backgroundTint="#EF4444"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnCloseHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Close"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- BOTTOM BAR: Back, Forward, Reload -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="#1E293B"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#38BDF8" />

        <ImageButton
            android:id="@+id/btnNavForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Forward"
            android:src="@android:drawable/ic_media_next"
            android:tint="#38BDF8" />

        <ImageButton
            android:id="@+id/btnNavReload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Reload"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#38BDF8" />

    </LinearLayout>

</RelativeLayout>
